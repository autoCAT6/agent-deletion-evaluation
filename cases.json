[
  {
    "id": "01-no-deletion-detection-control",
    "description": "Seed both stores but issue no deletion; observation must detect the target.",
    "skip_delete": true,
    "expected_final": {
      "main_query_visible": true,
      "derived_query_visible": true,
      "query_clean": false,
      "inspected_storage_clean": false,
      "receipt_completed": false,
      "applied_deletes": 0
    }
  },
  {
    "id": "02-premature-completion",
    "description": "Source declares completion before the downstream deletion is delivered.",
    "drop_delivery": true,
    "premature_receipt": true,
    "expected_final": {
      "main_query_visible": false,
      "derived_query_visible": true,
      "query_clean": false,
      "inspected_storage_clean": false,
      "receipt_completed": true,
      "pending_outbox": 1,
      "applied_deletes": 0
    }
  },
  {
    "id": "03-pending-delivery-visible",
    "description": "Accepted request remains pending when downstream delivery is absent.",
    "drop_delivery": true,
    "expected_final": {
      "main_query_visible": false,
      "derived_query_visible": true,
      "query_clean": false,
      "inspected_storage_clean": false,
      "receipt_completed": false,
      "pending_outbox": 1,
      "applied_deletes": 0
    }
  },
  {
    "id": "04-propagation-and-retention-complete",
    "description": "Apply downstream deletion, acknowledge, and expire snapshots at the declared inspection tick.",
    "expected_final": {
      "query_clean": true,
      "inspected_storage_clean": true,
      "receipt_completed": true,
      "pending_outbox": 0,
      "applied_deletes": 1,
      "tombstones": 1
    },
    "expected_observations": [
      {
        "stage": "after_receipt",
        "receipt_completed": false,
        "derived_query_visible": true
      },
      {
        "stage": "after_delivery_2",
        "query_clean": true,
        "receipt_completed": true,
        "snapshot_retains_canary": true
      }
    ]
  },
  {
    "id": "05-ack-loss-and-retry",
    "description": "Derived deletion commits, delivery acknowledgement is lost, and the queued event is retried.",
    "lose_ack": true,
    "expected_final": {
      "query_clean": true,
      "inspected_storage_clean": true,
      "receipt_completed": true,
      "pending_outbox": 0,
      "applied_deletes": 1,
      "tombstones": 1
    },
    "expected_actions": {
      "delivery_result": 2,
      "delivery_ack_lost": 1
    },
    "expected_observations": [
      {
        "stage": "after_delivery_2",
        "query_clean": true,
        "receipt_completed": false,
        "pending_outbox": 1,
        "applied_deletes": 1
      }
    ],
    "expected_action_decisions": {
      "delivery_result": [
        "deleted",
        "duplicate"
      ]
    }
  },
  {
    "id": "06-duplicate-request-and-delivery",
    "description": "Retry the same request and delivery without adding another deletion application.",
    "duplicate_request": true,
    "duplicate_delivery": true,
    "expected_final": {
      "query_clean": true,
      "inspected_storage_clean": true,
      "receipt_completed": true,
      "applied_deletes": 1,
      "tombstones": 1
    },
    "expected_actions": {
      "delete_retried": 1,
      "delivery_result": 1,
      "duplicate_delivery_result": 1
    },
    "expected_action_decisions": {
      "duplicate_delivery_result": [
        "duplicate"
      ]
    }
  },
  {
    "id": "07-stale-replay-without-tombstone",
    "description": "A delayed version-1 copy with a new event ID restores the deleted derived value.",
    "tombstone": false,
    "stale_replay": true,
    "expected_final": {
      "main_query_visible": false,
      "derived_query_visible": true,
      "query_clean": false,
      "inspected_storage_clean": false,
      "receipt_completed": true,
      "applied_deletes": 1,
      "tombstones": 0
    },
    "expected_observations": [
      {
        "stage": "after_delivery_3",
        "query_clean": true
      },
      {
        "stage": "after_stale_replay",
        "derived_query_visible": true
      }
    ],
    "expected_action_decisions": {
      "identical_upsert_replay": [
        "duplicate"
      ],
      "new_id_stale_upsert_replay": [
        "stored"
      ]
    }
  },
  {
    "id": "08-stale-replay-with-tombstone",
    "description": "The deletion revision rejects an old copy even when it has a new event ID.",
    "stale_replay": true,
    "expected_final": {
      "query_clean": true,
      "inspected_storage_clean": true,
      "receipt_completed": true,
      "applied_deletes": 1,
      "tombstones": 1
    },
    "expected_actions": {
      "identical_upsert_replay": 1,
      "new_id_stale_upsert_replay": 1
    },
    "expected_action_decisions": {
      "identical_upsert_replay": [
        "duplicate"
      ],
      "new_id_stale_upsert_replay": [
        "blocked_by_tombstone"
      ]
    }
  },
  {
    "id": "09-snapshot-retained-past-deadline",
