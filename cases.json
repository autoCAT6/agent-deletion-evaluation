    "expected_actions": {
      "deletion_ledger_applied_before_serving": 1
    },
    "expected_action_decisions": {
      "identical_upsert_replay": [
        "duplicate"
      ],
      "new_id_stale_upsert_replay": [
        "blocked_by_tombstone"
      ]
    }
  },
  {
    "id": "13-rollback-before-commit-and-retry",
